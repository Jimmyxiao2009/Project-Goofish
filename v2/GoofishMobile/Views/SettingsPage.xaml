<Page
    x:Class="Goofish.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="设置" Style="{StaticResource PageHeaderTextStyle}" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,0,12,24">

                <TextBlock Text="账户" Style="{StaticResource SectionTextStyle}" Margin="0,8,0,8" />
                <Grid Margin="0,4,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="64" Height="64">
                        <Ellipse Fill="{ThemeResource SystemControlBackgroundAccentBrush}" />
                        <TextBlock x:Name="AvatarInitial" Text="鱼" FontSize="26" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Ellipse>
                            <Ellipse.Fill>
                                <ImageBrush x:Name="AvatarImage" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="AccountName" FontSize="20" FontWeight="SemiLight" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="AccountStatus" Style="{StaticResource MetaTextStyle}" FontSize="13" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                <Button x:Name="AccountButton" MinWidth="96" Click="Account_Click" />

                <TextBlock Text="主题" Style="{StaticResource SectionTextStyle}" />
                <RadioButton x:Name="ThemeDark" Content="深色" GroupName="Theme" Tag="dark" Checked="Theme_Checked" />
                <RadioButton x:Name="ThemeLight" Content="浅色" GroupName="Theme" Tag="light" Checked="Theme_Checked" />
                <RadioButton x:Name="ThemeSystem" Content="使用 Windows 设置" GroupName="Theme" Tag="system" Checked="Theme_Checked" />
                <TextBlock Text="强调色跟随“设置 → 个性化 → 颜色”。" Style="{StaticResource HintTextStyle}" Margin="0,6,0,0" />

                <TextBlock Text="演示数据" Style="{StaticResource SectionTextStyle}" />
                <ToggleSwitch x:Name="DemoSwitch" OffContent="关" OnContent="开" Toggled="DemoSwitch_Toggled" />
                <TextBlock Text="不登录也能浏览示例宝贝、体验私信。登录后自动改用真实数据。" Style="{StaticResource HintTextStyle}" />

                <TextBlock Text="省流量" Style="{StaticResource SectionTextStyle}" />
                <ToggleSwitch x:Name="SaverSwitch" OffContent="关" OnContent="开" Toggled="SaverSwitch_Toggled" />
                <TextBlock Text="只加载小尺寸图片，适合使用移动数据时打开。" Style="{StaticResource HintTextStyle}" />

                <TextBlock Text="通知" Style="{StaticResource SectionTextStyle}" />
                <ToggleSwitch x:Name="NotifySwitch" OffContent="关" OnContent="开" Toggled="NotifySwitch_Toggled" />
                <TextBlock Text="收到新私信时显示横幅通知。" Style="{StaticResource HintTextStyle}" />

                <TextBlock Text="搜索历史" Style="{StaticResource SectionTextStyle}" />
                <Button Content="清除搜索历史" MinWidth="96" Click="ClearHistory_Click" />

                <TextBlock Text="关于" Style="{StaticResource SectionTextStyle}" />
                <TextBlock Style="{StaticResource HintTextStyle}"
                           Text="闲鱼 for Windows 10 Mobile（第三方客户端）&#x0a;版本 2.0.0.0" />
                <TextBlock Style="{StaticResource HintTextStyle}"
                           Text="不支持付款与下单。数据来自闲鱼网页版使用的接口，接口可能随时变化。本应用与阿里巴巴及闲鱼无关。" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
