<Page
    x:Class="Goofish.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="账户" Style="{StaticResource PageHeaderTextStyle}" />
        <TextBlock Grid.Row="1" Text="登录闲鱼" Style="{StaticResource PageTitleTextStyle}" />

        <ScrollViewer Grid.Row="2" Padding="12,0,12,12" VerticalScrollBarVisibility="Auto">
            <!-- 不垂直居中：内容比视口高时，居中会把顶部（二维码）裁掉 -->
            <StackPanel VerticalAlignment="Top">
                <TextBlock Style="{StaticResource HintTextStyle}" TextAlignment="Center"
                           Text="用手机上的闲鱼 App 扫下面的二维码，然后在手机上确认登录。如果本机就是手机，请用另一台设备扫码。" />

                <Grid Margin="0,4,0,12" HorizontalAlignment="Center">
                    <Border x:Name="QrFrame" Background="White" BorderThickness="1"
                            BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}">
                        <!-- 必须 Uniform：位图按设备缩放渲染（手机上约 3~4 倍像素），
                             Stretch=None 会按位图像素当 DIP 画出来，视觉尺寸放大数倍导致溢出 -->
                        <Image x:Name="QrImage" Stretch="Uniform" />
                    </Border>
                    <ProgressRing x:Name="BusyRing" Width="48" Height="48"
                                  IsActive="False" Visibility="Collapsed"
                                  Foreground="{ThemeResource SystemControlForegroundAccentBrush}" />
                </Grid>

                <TextBlock x:Name="StatusText" Style="{StaticResource HintTextStyle}"
                           TextAlignment="Center" Text="正在获取二维码…" />

                <Button x:Name="RetryButton" Content="重新获取二维码" Visibility="Collapsed"
                        HorizontalAlignment="Center" MinWidth="140" Margin="0,0,0,12"
                        Click="Reload_Click" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Margin="12,4,12,12">
            <HyperlinkButton Content="用 Cookie 登录（高级）" Click="CookieLogin_Click" Padding="0,6" />
            <HyperlinkButton Content="暂不登录，先逛逛" Click="Skip_Click" Padding="0,6" />
        </StackPanel>
    </Grid>
</Page>
