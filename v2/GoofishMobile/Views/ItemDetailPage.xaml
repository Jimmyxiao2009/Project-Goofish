<Page
    x:Class="Goofish.Views.ItemDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 大图：高度在 code-behind 里设为与宽度相同 -->
                <Grid x:Name="Gallery" Height="360">
                    <FlipView x:Name="GalleryFlip" ItemsSource="{Binding Slides}"
                              SelectedIndex="{Binding SlideIndex, Mode=TwoWay}"
                              Background="{ThemeResource CardBrush}">
                        <FlipView.ItemTemplate>
                            <DataTemplate>
                                <Grid Background="{Binding Color, Converter={StaticResource ColorBrush}}">
                                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="{Binding Glyph}"
                                              FontSize="120" Foreground="White" />
                                    <Image Source="{Binding Url, Converter={StaticResource ImageUrl}}" Stretch="UniformToFill" />
                                </Grid>
                            </DataTemplate>
                        </FlipView.ItemTemplate>
                    </FlipView>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" Padding="8,2"
                            Background="#99000000"
                            Visibility="{Binding SlideText, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="{Binding SlideText}" FontSize="12" Foreground="White" />
                    </Border>
                </Grid>

                <!-- 详情未返回时先显示列表里带过来的标题与价格 -->
                <StackPanel Margin="12" Visibility="{Binding HasItem, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}">
                    <TextBlock Text="{Binding Preview.PriceText}" FontSize="32" FontWeight="Light"
                               Foreground="{ThemeResource SystemControlForegroundAccentBrush}" />
                    <TextBlock Text="{Binding Preview.Title}" FontSize="20" FontWeight="SemiLight" TextWrapping="Wrap" Margin="0,6,0,8" />
                    <TextBlock Text="{Binding Error}" Style="{StaticResource HintTextStyle}" Margin="0,12,0,0"
                               Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}" />
                    <Button Content="重试" MinWidth="96" Click="Retry_Click"
                            Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}" />
                </StackPanel>

                <StackPanel Margin="12" Visibility="{Binding HasItem, Converter={StaticResource VisibleWhen}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Item.PriceText}" FontSize="32" FontWeight="Light"
                                   Foreground="{ThemeResource SystemControlForegroundAccentBrush}" />
                        <Grid Margin="8,0,0,6" VerticalAlignment="Bottom"
                              Visibility="{Binding Item.OriginalPriceText, Converter={StaticResource VisibleWhen}}">
                            <TextBlock FontSize="14" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}">
                                <Run Text="原价" /><Run Text="{Binding Item.OriginalPriceText}" />
                            </TextBlock>
                            <Rectangle Height="1" VerticalAlignment="Center" Margin="0,2,0,0"
                                       Fill="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                        </Grid>
                        <TextBlock Text="{Binding Item.ShippingText}" FontSize="13" Margin="8,0,0,7" VerticalAlignment="Bottom"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                    </StackPanel>

                    <TextBlock Text="{Binding Item.Title}" FontSize="20" FontWeight="SemiLight" TextWrapping="Wrap"
                               LineHeight="27" Margin="0,6,0,8" IsTextSelectionEnabled="True" />
                    <TextBlock Text="{Binding Item.StatsText}" FontSize="13"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />

                    <Rectangle Height="1" Margin="0,12" Fill="{ThemeResource SystemControlForegroundBaseLowBrush}" />

                    <!-- 卖家：点击进入 TA 的个人主页 -->
                    <Button x:Name="SellerButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Background="Transparent" BorderThickness="0" Padding="0" Click="Seller_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="48" Height="48">
                                <Ellipse Fill="{Binding Item.Seller.AvatarColor, Converter={StaticResource ColorBrush}}" />
                                <TextBlock Text="{Binding Item.Seller.Initial}" FontSize="20" FontWeight="SemiLight" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <ImageBrush Stretch="UniformToFill"
                                                    ImageSource="{Binding Item.Seller.AvatarUrl, Converter={StaticResource ImageUrl}, ConverterParameter=48}" />
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Item.Seller.Nick}" FontSize="17" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Item.Seller.CreditLine}" Style="{StaticResource MetaTextStyle}" FontSize="13" />
                                <TextBlock Text="{Binding Item.Seller.ActivityLine}" Style="{StaticResource MetaTextStyle}" FontSize="13"
                                           Visibility="{Binding Item.Seller.ActivityLine, Converter={StaticResource VisibleWhen}}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE76C;" FontSize="12"
                                      Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                        </Grid>
                    </Button>

                    <Rectangle Height="1" Margin="0,12" Fill="{ThemeResource SystemControlForegroundBaseLowBrush}" />

                    <Grid Visibility="{Binding Item.Condition, Converter={StaticResource VisibleWhen}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="成色" FontSize="14" LineHeight="26" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding Item.Condition}" FontSize="14" LineHeight="26" />
                    </Grid>
                    <Grid Visibility="{Binding Item.BargainText, Converter={StaticResource VisibleWhen}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="议价" FontSize="14" LineHeight="26" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding Item.BargainText}" FontSize="14" LineHeight="26" />
                    </Grid>
                    <Grid Visibility="{Binding Item.City, Converter={StaticResource VisibleWhen}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="发货地" FontSize="14" LineHeight="26" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding Item.City}" FontSize="14" LineHeight="26" />
                    </Grid>
                    <Grid Visibility="{Binding Item.PublishText, Converter={StaticResource VisibleWhen}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="发布" FontSize="14" LineHeight="26" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding Item.PublishText}" FontSize="14" LineHeight="26" />
                    </Grid>

                    <Rectangle Height="1" Margin="0,12" Fill="{ThemeResource SystemControlForegroundBaseLowBrush}" />

                    <TextBlock Text="{Binding Item.Description}" FontSize="15" LineHeight="24" TextWrapping="Wrap"
                               IsTextSelectionEnabled="True"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumHighBrush}" />

                    <TextBlock Text="{Binding Item.IdText}" Style="{StaticResource MetaTextStyle}" FontSize="13"
                               HorizontalAlignment="Center" Margin="0,24,0,24" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>

    <Page.BottomAppBar>
        <CommandBar x:Name="AppBar">
            <AppBarButton x:Name="FavoriteButton" Label="收藏" Click="Favorite_Click">
                <AppBarButton.Icon>
                    <SymbolIcon x:Name="FavoriteIcon" Symbol="OutlineStar" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="ChatButton" Icon="Message" Label="聊一聊" Click="Chat_Click" />
            <AppBarButton x:Name="ShareButton" Label="共享" Click="Share_Click">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE72D;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <CommandBar.SecondaryCommands>
                <AppBarButton Label="在浏览器中打开" Click="OpenInBrowser_Click" />
                <AppBarButton Label="复制链接" Click="CopyLink_Click" />
            </CommandBar.SecondaryCommands>
        </CommandBar>
    </Page.BottomAppBar>
</Page>
