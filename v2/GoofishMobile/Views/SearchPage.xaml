<Page
    x:Class="Goofish.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <DataTemplate x:Key="KeywordTemplate">
            <Grid Height="44">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE81C;" FontSize="16"
                          Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" HorizontalAlignment="Left" />
                <TextBlock Grid.Column="1" Text="{Binding}" FontSize="17" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="HotTemplate">
            <Grid Height="44">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE721;" FontSize="16"
                          Foreground="{ThemeResource SystemControlForegroundAccentBrush}" HorizontalAlignment="Left" />
                <TextBlock Grid.Column="1" Text="{Binding}" FontSize="17" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="搜索" Style="{StaticResource PageHeaderTextStyle}" />

        <AutoSuggestBox x:Name="SearchBox" Grid.Row="1" Margin="12,0,12,8"
                        PlaceholderText="搜索闲置宝贝"
                        QueryIcon="Find"
                        ItemsSource="{Binding Suggestions}"
                        TextChanged="SearchBox_TextChanged"
                        QuerySubmitted="SearchBox_QuerySubmitted" />

        <ComboBox Grid.Row="2" Margin="12,0,12,6" HorizontalAlignment="Stretch"
                  ItemsSource="{Binding SortOptions}"
                  SelectedIndex="{Binding SortIndex, Mode=TwoWay}"
                  Visibility="{Binding HasSearched, Converter={StaticResource VisibleWhen}}" />

        <!-- 未搜索：最近搜索 + 热门 -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasSearched, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}">
            <StackPanel>
                <TextBlock Text="最近搜索" Style="{StaticResource SectionLabelTextStyle}"
                           Visibility="{Binding History.Count, Converter={StaticResource VisibleWhen}}" />
                <ListView ItemsSource="{Binding History}" ItemTemplate="{StaticResource KeywordTemplate}"
                          ItemContainerStyle="{StaticResource PlainItemStyle}"
                          SelectionMode="None" IsItemClickEnabled="True" ItemClick="Keyword_Click"
                          ScrollViewer.VerticalScrollMode="Disabled" />
                <TextBlock Text="大家都在搜" Style="{StaticResource SectionLabelTextStyle}" />
                <ListView ItemsSource="{Binding HotKeywords}" ItemTemplate="{StaticResource HotTemplate}"
                          ItemContainerStyle="{StaticResource PlainItemStyle}"
                          SelectionMode="None" IsItemClickEnabled="True" ItemClick="Keyword_Click"
                          ScrollViewer.VerticalScrollMode="Disabled" />
            </StackPanel>
        </ScrollViewer>

        <!-- 搜索结果 -->
        <ListView x:Name="ResultList" Grid.Row="3"
                  ItemsSource="{Binding Results}"
                  ItemTemplate="{StaticResource ItemRowTemplate}"
                  ItemContainerStyle="{StaticResource RowItemStyle}"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="Result_Click"
                  Visibility="{Binding HasSearched, Converter={StaticResource VisibleWhen}}">
            <ListView.Header>
                <TextBlock Text="{Binding Summary}" Style="{StaticResource HintTextStyle}" Margin="12,4,12,4"
                           Visibility="{Binding Summary, Converter={StaticResource VisibleWhen}}" />
            </ListView.Header>
        </ListView>

        <TextBlock Grid.Row="3" Text="{Binding Message}" Style="{StaticResource EmptyTextStyle}"
                   VerticalAlignment="Center" Margin="24,0"
                   Visibility="{Binding Message, Converter={StaticResource VisibleWhen}}" />
    </Grid>

    <Page.BottomAppBar>
        <CommandBar ClosedDisplayMode="Minimal">
            <CommandBar.SecondaryCommands>
                <AppBarButton Label="清除搜索历史" Click="ClearHistory_Click" />
            </CommandBar.SecondaryCommands>
        </CommandBar>
    </Page.BottomAppBar>
</Page>
