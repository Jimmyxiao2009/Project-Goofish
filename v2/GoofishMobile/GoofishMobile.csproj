    <!-- 6.x 起要求最低 16299，Windows 10 Mobile 只能停在 5.4.x -->
    <PackageReference Include="Microsoft.NETCore.UniversalWindowsPlatform">
      <Version>5.4.7</Version>
    </PackageReference>
    <!-- 排除 NuGet 默认选的 netstandard 版，改用下面的可移植版，原因见 Reference 注释 -->
    <PackageReference Include="Newtonsoft.Json" Version="12.0.3" ExcludeAssets="compile;runtime" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup>
    <!--
      这个工程在桌面上调试时进程加载的是 clr.dll（.NET Framework 4.x）而不是 coreclr.dll。
      NuGet 给 UAP 选的 netstandard 版 Newtonsoft 在那套运行时上会抛 FieldAccessException
      （JsonSerializer..ctor 访问 JsonSerializerSettings.DefaultContext）。
      net45 版又引用了 UWP 里没有的 mscorlib 类型、编译不过。
      可移植版（PCL）两边都认：UWP 能编译，.NET Framework 与 .NET Native 都能跑。
    -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(PkgNewtonsoft_Json)\lib\portable-net45+win8+wp8+wpa81\Newtonsoft.Json.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
