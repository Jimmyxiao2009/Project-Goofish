<Page
    x:Class="ProjectGoofish.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ProjectGoofish.Models"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部宝贝咨询卡片 -->
        <Grid Grid.Row="0" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Source="{x:Bind ViewModel.ActiveConversation.ItemThumb, Mode=OneWay}" Width="40" Height="40" Margin="0,0,10,0"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.ActiveConversation.ItemTitle, Mode=OneWay}" FontSize="12" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{x:Bind ViewModel.ActiveConversation.ItemPrice, Mode=OneWay}" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" FontWeight="SemiBold" FontSize="13"/>
            </StackPanel>
        </Grid>

        <!-- 消息气泡流 (Windows 10 Messaging 规范) -->
        <ListView
            x:Name="MessagesListView"
            Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.CurrentMessages, Mode=OneWay}"
            SelectionMode="None"
            Padding="12">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ChatMessage">
                    <Grid Margin="0,6">
                        <!-- 买家自己发送的消息 (右对齐，系统强调色) -->
                        <Border
                            Visibility="{x:Bind IsOutgoing, Mode=OneWay}"
                            HorizontalAlignment="Right"
                            Background="{ThemeResource SystemControlHighlightAccentBrush}"
                            Padding="12,8"
                            MaxWidth="260">
                            <StackPanel>
                                <TextBlock Text="{x:Bind Text}" Foreground="Black" TextWrapping="Wrap" FontSize="14"/>
                                <TextBlock Text="{x:Bind Time}" Foreground="#66000000" FontSize="9" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 卖家回复的消息 (左对齐，深灰色气泡) -->
                        <Border
                            Visibility="{x:Bind IsOutgoing, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                            HorizontalAlignment="Left"
                            Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
                            Padding="12,8"
                            MaxWidth="260">
                            <StackPanel>
                                <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" FontSize="14"/>
                                <TextBlock Text="{x:Bind Time}" Foreground="{ThemeResource SystemControlDisabledBaseMediumLowBrush}" FontSize="9" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 底部输入框与发送按钮 -->
        <Grid Grid.Row="2" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" Padding="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="MessageInputBox" Grid.Column="0" PlaceholderText="输入私信内容..." KeyDown="MessageInputBox_KeyDown"/>
            <Button x:Name="SendButton" Grid.Column="1" Margin="8,0,0,0" Click="SendButton_Click" Background="{ThemeResource SystemControlHighlightAccentBrush}">
                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE724;"/>
            </Button>
        </Grid>
    </Grid>
</Page>
