<Page
    x:Class="ProjectGoofish.Views.ItemDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <ScrollViewer>
            <StackPanel Padding="0,0,0,72">
                <!-- 大图轮播预览 -->
                <FlipView Height="340" ItemsSource="{x:Bind ViewModel.Item.Images, Mode=OneWay}">
                    <FlipView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Image Source="{x:Bind}" Stretch="UniformToFill"/>
                        </DataTemplate>
                    </FlipView.ItemTemplate>
                </FlipView>

                <!-- 价格与统计指标 -->
                <Grid Padding="16,12" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="{x:Bind ViewModel.Item.FormattedPrice, Mode=OneWay}" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" FontSize="26" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.Item.WantCount, Mode=OneWay}" Foreground="{ThemeResource SystemControlDisabledBaseMediumLowBrush}" FontSize="12"/>
                        <TextBlock Text="人想要" Foreground="{ThemeResource SystemControlDisabledBaseMediumLowBrush}" FontSize="12" Margin="2,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 标题与详情描述 -->
                <StackPanel Padding="16,12">
                    <TextBlock Text="{x:Bind ViewModel.Item.Title, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="{x:Bind ViewModel.Item.Description, Mode=OneWay}" FontSize="14" LineHeight="22" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- 卖家卡片 (Windows Tile 风格) -->
                <Grid Margin="16,12" Padding="12" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Source="{x:Bind ViewModel.Item.Seller.Avatar, Mode=OneWay}" Width="48" Height="48" Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.Item.Seller.Nick, Mode=OneWay}" FontWeight="SemiBold" FontSize="14"/>
                        <Border Background="#008272" HorizontalAlignment="Left" Padding="6,2" Margin="0,4,0,0">
                            <TextBlock Text="{x:Bind ViewModel.Item.Seller.CreditScore, Mode=OneWay}" FontSize="10" Foreground="White"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- 加载动画 -->
        <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>

    <Page.BottomAppBar>
        <CommandBar x:Name="DetailCommandBar">
            <AppBarButton Icon="Back" Label="返回" Click="Back_Click"/>
            <AppBarToggleButton x:Name="FavToggleBtn" Icon="Favorite" Label="收藏" IsChecked="{x:Bind ViewModel.Item.IsFavorite, Mode=OneWay}" Click="Favorite_Click"/>
            <AppBarButton Icon="Message" Label="联系卖家" Click="Chat_Click"/>
        </CommandBar>
    </Page.BottomAppBar>
</Page>
