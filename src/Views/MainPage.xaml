<Page
    x:Class="ProjectGoofish.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ProjectGoofish.Models"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <!-- Windows 10 Mobile Pivot 核心容器 -->
        <Pivot x:Name="RootPivot" Title="闲鱼 GOOFISH" SelectionChanged="Pivot_SelectionChanged">
            <!-- 推荐 Tab -->
            <PivotItem Header="推荐">
                <GridView
                    x:Name="FeedGridView"
                    ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                    ItemClick="FeedGridView_ItemClick"
                    IsItemClickEnabled="True">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:ItemDetail">
                            <Grid Width="175" Margin="4" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="175"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 商品首图 -->
                                <Image Grid.Row="0" Source="{x:Bind PrimaryImageUrl}" Stretch="UniformToFill"/>

                                <!-- 标题 -->
                                <TextBlock Grid.Row="1" Text="{x:Bind Title}" MaxLines="2" TextTrimming="CharacterEllipsis" Margin="8,6,8,2" FontSize="13" TextWrapping="Wrap"/>

                                <!-- 价格 -->
                                <TextBlock Grid.Row="2" Text="{x:Bind FormattedPrice}" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" FontWeight="SemiBold" FontSize="16" Margin="8,2,8,2"/>

                                <!-- 卖家信息与城市 -->
                                <Grid Grid.Row="3" Margin="8,2,8,8">
                                    <TextBlock Text="{x:Bind Seller.Nick}" FontSize="11" Foreground="{ThemeResource SystemControlDisabledBaseMediumLowBrush}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{x:Bind City}" FontSize="11" Foreground="{ThemeResource SystemControlDisabledBaseMediumLowBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </PivotItem>

            <!-- 数码外设 Tab -->
            <PivotItem Header="数码外设">
                <TextBlock Text="数码好物列表" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{ThemeResource SubheaderTextBlockStyle}"/>
            </PivotItem>

            <!-- 潮玩二次元 Tab -->
            <PivotItem Header="潮玩二次元">
                <TextBlock Text="二次元模玩列表" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{ThemeResource SubheaderTextBlockStyle}"/>
            </PivotItem>
        </Pivot>

        <!-- 正在加载蒙层 -->
        <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>

    <!-- 底部 CommandBar (符合 Windows 10 Mobile 规范) -->
    <Page.BottomAppBar>
        <CommandBar x:Name="MainCommandBar">
            <AppBarButton Icon="Refresh" Label="刷新" Click="Refresh_Click"/>
            <AppBarButton Icon="Find" Label="搜索" Click="Search_Click"/>
            <AppBarButton Icon="Message" Label="消息" Click="Messages_Click"/>
            <AppBarButton Icon="Favorite" Label="我的收藏" Click="Favorites_Click"/>

            <CommandBar.SecondaryCommands>
                <AppBarButton Label="切换主题风格" Click="ToggleTheme_Click"/>
                <AppBarButton Label="关于 Project Goofish" Click="About_Click"/>
            </CommandBar.SecondaryCommands>
        </CommandBar>
    </Page.BottomAppBar>
</Page>
